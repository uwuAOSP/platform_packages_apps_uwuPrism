android_app {
    name: "uwuPrism",

    srcs: ["src/**/*.kt"],
    resource_dirs: ["res"],
    asset_dirs: ["assets"],
    manifest: "AndroidManifest.xml",

    platform_apis: true,
    system_ext_specific: true,
    certificate: "platform",
    privileged: true,
    use_embedded_native_libs: true,
    jni_libs: ["libuwu_prism_tesseract_jni"],
    required: ["privapp_whitelist_org.uwuaosp.prism"],

    aaptflags: ["-0", "traineddata"],

    static_libs: [
        "androidx.activity_activity",
        "androidx.activity_activity-compose",
        "androidx.compose.foundation_foundation",
        "androidx.compose.foundation_foundation-layout",
        "androidx.compose.material3_material3",
        "androidx.compose.material_material-icons-extended",
        "androidx.compose.runtime_runtime",
        "androidx.compose.runtime_runtime-saveable",
        "androidx.compose.ui_ui",
        "androidx.compose.ui_ui-graphics",
        "androidx.core_core-ktx",
        "kotlin-stdlib",
        "kotlinx_coroutines",
        "kotlinx_coroutines_android",
        "SettingsLib",
        "uwuComposeSettingsLib",
        "uwu_ocr_aidl",
    ],

    kotlincflags: ["-Xjvm-default=all"],

    optimize: {
        optimize: true,
        proguard_flags_files: ["proguard-rules.pro"],
        shrink_resources: true,
    },
}

cc_library_shared {
    name: "libuwu_prism_tesseract_jni",
    srcs: ["jni/uwu_prism_tesseract_jni.cpp"],
    system_ext_specific: true,
    compile_multilib: "64",
    cpp_std: "c++17",
    rtti: true,
    lto: {
        never: true,
    },
    include_dirs: [
        "external/leptonica/src",
        "external/tesseract/include",
    ],
    header_libs: ["jni_headers"],
    static_libs: [
        "libtesseract",
        "libleptonica",
    ],
    shared_libs: [
        "liblog",
        "libpng",
        "libz",
    ],
}

prebuilt_etc {
    name: "privapp_whitelist_org.uwuaosp.prism",
    system_ext_specific: true,
    sub_dir: "permissions",
    src: "privapp_whitelist_org.uwuaosp.prism.xml",
    filename_from_src: true,
}
